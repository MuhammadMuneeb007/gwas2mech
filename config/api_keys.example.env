# Copy to config/api_keys.env (git-ignored) and fill in. One KEY=value per line.
# Only needed for Step08 --online screen and (optional) BioGRID in Step15.
# An exported environment variable of the same name takes precedence over this file.
#
# SCREEN (ENCODE, Weng lab) GraphQL API key: https://screen.wenglab.org
SCREEN_API_KEY=

# BioGRID REST access key (optional, Step15 cross-validation): https://webservice.thebiogrid.org
BIOGRID_ACCESS_KEY=
